local function DesligarImpulso()
    impulsoAtivo = false

    if impulsoConnection then
        impulsoConnection:Disconnect()
        impulsoConnection = nil
    end

    if humanoidImpulso and humanoidImpulso.Parent then
        if humanoidImpulso.Health > 0 then
            humanoidImpulso.WalkSpeed = velocidadeOriginal or 16
        end
    end

    humanoidImpulso = nil
    velocidadeOriginal = nil

    if slot and slot.Parent then
        slot.BackgroundColor3 = OFF_COLOR
    end
end

local function LigarImpulso()
    local character = LocalPlayer.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 then
        return
    end

    humanoidImpulso = humanoid
    velocidadeOriginal = humanoid.WalkSpeed
    impulsoAtivo = true

    humanoid.WalkSpeed = 100
    slot.BackgroundColor3 = ON_COLOR

    if impulsoConnection then
        impulsoConnection:Disconnect()
        impulsoConnection = nil
    end

    impulsoConnection = RunService.Heartbeat:Connect(function()
        if destroyed or _G.__OrbitImpulsoRunToken ~= RunToken then
            DesligarImpulso()
            return
        end

        if not humanoidImpulso
            or not humanoidImpulso.Parent
            or humanoidImpulso.Health <= 0 then

            DesligarImpulso()
            return
        end

        humanoidImpulso.WalkSpeed = 100
    end)
end

slot.Activated:Connect(function()
    if impulsoAtivo then
        DesligarImpulso()
    else
        LigarImpulso()
    end
end)

