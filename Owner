        LockButton.BackgroundColor3 = NORMAL_COLOR
        RestoreLocalCamera()
    elseif GetTargetRoot() then
        lockOn = true
        LockButton.BackgroundColor3 = LOCK_COLOR

        RestoreLocalCamera()
        StartLockCamera()
    end
end)

