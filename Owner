    AutoButton.BackgroundColor3 = OFF_COLOR

    RestoreLocalCamera()

    for _, button in ipairs(PlayerList:GetChildren()) do
        if button:IsA("TextButton") then
            button.TextColor3 = Color3.new(1, 1, 1)
        end
    end
end

--// SELECIONAR ALVO
local function SelectTarget(target, isNPC)
    if orbiting then return end

    if selectedTarget == target and targetIsNPC == isNPC then
        ClearTarget()
        return
    end

    StopLockCamera()

    selectedTarget = target
    targetIsNPC = isNPC
    autoTarget = false

    AutoButton.BackgroundColor3 = OFF_COLOR

    WatchTargetDeath(target)

    for _, button in ipairs(PlayerList:GetChildren()) do
        if button:IsA("TextButton") then
            local sameTarget = button:GetAttribute("TargetKey")
                == (isNPC and target:GetDebugId() or target.Name)

            button.TextColor3 = sameTarget
                and SELECTED_COLOR
                or Color3.new(1, 1, 1)
        end
    end

    CreateESP(target)

    if lockOn then
        StartLockCamera()
    end
end

--// VERIFICAR NPC
local function IsNPC(model)
    if not model:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(model) then return false end

    return model:FindFirstChildOfClass("Humanoid") ~= nil
end

--// ATUALIZAR LISTA
local function UpdatePlayerList()
    if destroyed then return end

    for _, child in ipairs(PlayerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    Title.Text = showingNPCs and "NPCs" or "Orbit"
    NPCButton.BackgroundColor3 = showingNPCs and LOCK_COLOR or NORMAL_COLOR

    local targets = {}

    if showingNPCs then
        for _, object in ipairs(workspace:GetDescendants()) do
            if IsNPC(object) then
                table.insert(targets, object)
            end
        end
    else
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                table.insert(targets, player)
            end
        end
    end

    table.sort(targets, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)

    for _, target in ipairs(targets) do
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(1, -8, 0, 30)
        button.BackgroundColor3 = NORMAL_COLOR
        button.BackgroundTransparency = 0.05
        button.BorderSizePixel = 0
        button.Text = target.Name
        button.TextColor3 = (
            selectedTarget == target
            and targetIsNPC == showingNPCs
        ) and SELECTED_COLOR or Color3.new(1, 1, 1)
        button.TextSize = 13
        button.Font = Enum.Font.Gotham
        button.ZIndex = 12

        -- Guarda a identificação como texto para evitar atributos inválidos.
        local targetKey

        if showingNPCs then
            targetKey = target:GetDebugId()
        else
            targetKey = target.Name
        end

        button:SetAttribute("TargetKey", targetKey)
        button.Parent = PlayerList

        button.Activated:Connect(function()
            SelectTarget(target, showingNPCs)
        end)
    end

    task.defer(function()
        if not destroyed then
            PlayerList.CanvasSize = UDim2.new(
                0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 5
            )
        end
    end)
end

--// ORBIT
local function StopOrbit()
    orbiting = false
    lastDirection = nil
    teleportTimer = 0

    OrbitButton.Text = "Orbit: OFF"
    OrbitButton.BackgroundColor3 = OFF_COLOR

    RestoreLocalCamera()

    if lockOnBeforeOrbit and selectedTarget and GetTargetRoot() then
        lockOn = true
        LockButton.BackgroundColor3 = LOCK_COLOR
        StartLockCamera()
    else
        lockOn = false
        LockButton.BackgroundColor3 = NORMAL_COLOR
        StopLockCamera()
    end

    lockOnBeforeOrbit = false
end

local function StartOrbit()
    if not selectedTarget then
        OrbitButton.Text = "Selecione alguém!"

        task.delay(1, function()
            if not destroyed and not orbiting then
                OrbitButton.Text = "Orbit: OFF"
            end
        end)

        return
    end

    if not GetTargetRoot() then
        ClearTarget()
        return
    end

    UpdateDistance()

    lockOnBeforeOrbit = lockOn
    lockOn = false
    StopLockCamera()

    LockButton.BackgroundColor3 = NORMAL_COLOR

    orbiting = true
    lastDirection = nil
    teleportTimer = 0

    OrbitButton.Text = "Orbit: ON"
    OrbitButton.BackgroundColor3 = ON_COLOR

    ViewSelectedTarget()
end

OrbitButton.Activated:Connect(function()
    if orbiting then
        StopOrbit()
    else
        StartOrbit()
    end
end)

--// LOCK ON
LockButton.Activated:Connect(function()
