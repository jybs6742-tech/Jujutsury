--// ALVO
local function GetTargetCharacter()
    if not selectedTarget then
        return nil
    end

    if targetIsNPC then
        return selectedTarget
    end

    return selectedTarget.Character
end

local function GetTargetRoot()
    local character = GetTargetCharacter()
    if not character then return nil end

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
end

--// RESTAURAR CÂMERA LOCAL
local function RestoreLocalCamera()
    local camera = workspace.CurrentCamera
    if not camera then return end

    camera.CameraType = Enum.CameraType.Custom

    local character = LocalPlayer.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        camera.CameraSubject = humanoid
    end
end

--// ORBIT: CÂMERA SEGUE O HUMANOID DO ALVO
local function ViewSelectedTarget()
    local camera = workspace.CurrentCamera
    local character = GetTargetCharacter()

    if not camera or not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    camera.CameraType = Enum.CameraType.Custom
    camera.CameraSubject = humanoid
end

--// LOCK ON: MIRA NA CABEÇA A CADA FRAME
local function StopLockCamera()
    pcall(function()
        RunService:UnbindFromRenderStep(LockBindName)
    end)
end

local function StartLockCamera()
    StopLockCamera()

    RunService:BindToRenderStep(
        LockBindName,
        Enum.RenderPriority.Camera.Value + 1,
        function()
            if destroyed or not lockOn or orbiting then
                return
            end

            if not selectedTarget then
                return
            end

            local camera = workspace.CurrentCamera
            local localCharacter = LocalPlayer.Character
            local localHumanoid = localCharacter
                and localCharacter:FindFirstChildOfClass("Humanoid")

            local targetCharacter = GetTargetCharacter()
            local targetHead = targetCharacter
                and targetCharacter:FindFirstChild("Head")

            if not camera or not localHumanoid or not targetHead then
                return
            end

            -- A câmera continua vinculada ao seu personagem.
            camera.CameraType = Enum.CameraType.Custom

            if camera.CameraSubject ~= localHumanoid then
                camera.CameraSubject = localHumanoid
            end

            -- Atualiza a mira depois da atualização da câmera padrão.
            camera.CFrame = CFrame.lookAt(
                camera.CFrame.Position,
                targetHead.Position
            )
        end
    )
end

--// ESP
local function RemoveESP()
    if ESP then
        ESP:Destroy()
        ESP = nil
    end
end

local function CreateESP(target)
    RemoveESP()
    if not target then return end

    local character

    if targetIsNPC then
        character = target
    else
        character = target.Character
    end

    if not character then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "SelectedTargetESP"
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    ESP = highlight
end

--// MORTE DO ALVO
local function DisconnectTargetDeath()
    if targetDeathConnection then
        targetDeathConnection:Disconnect()
        targetDeathConnection = nil
    end
end

local ClearTarget

local function WatchTargetDeath(target)
    DisconnectTargetDeath()
    if not target then return end

    local function onDeath()
        if not destroyed and selectedTarget == target then
            ClearTarget()
        end
    end

    if targetIsNPC then
        local humanoid = target:FindFirstChildOfClass("Humanoid")

        if humanoid then
            targetDeathConnection = humanoid.Died:Connect(onDeath)
        end
    elseif target:IsA("Player") then
        targetDeathConnection = target.CharacterRemoving:Connect(onDeath)

        local character = target.Character
        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")

        if humanoid then
            humanoid.Died:Connect(onDeath)
        end
    end
end

