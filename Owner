--// ATUALIZAÇÃO DO ORBIT
RunService.RenderStepped:Connect(function(deltaTime)
    if destroyed or _G.__OrbitImpulsoRunToken ~= RunToken then
        return
    end

    -- AUTO TARGET
    if autoTarget and not orbiting then
        local nearest = GetNearestPlayer()

        if nearest then
            if selectedTarget ~= nearest or targetIsNPC then
                SelectTarget(nearest, false)
                autoTarget = true
                AutoButton.BackgroundColor3 = ON_COLOR
            end
        else
            ClearTarget()
        end
    end

    -- ORBIT
    if not orbiting then return end

    if not selectedTarget then
        StopOrbit()
        return
    end

    local myCharacter = LocalPlayer.Character
    local targetCharacter = GetTargetCharacter()

    if not myCharacter or not targetCharacter then
        ClearTarget()
        return
    end

    local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
    local targetRoot = GetTargetRoot()

    if not myRoot or not targetRoot then
        ClearTarget()
        return
    end

    teleportTimer += deltaTime

    local interval = 1 / ORBIT_SPEED
    if teleportTimer < interval then return end

    teleportTimer = 0

    local directions = {
        targetRoot.CFrame.LookVector,
        -targetRoot.CFrame.LookVector,
        targetRoot.CFrame.RightVector,
        -targetRoot.CFrame.RightVector
    }

    local availableDirections = {}

    for _, direction in ipairs(directions) do
        if direction ~= lastDirection then
            table.insert(availableDirections, direction)
        end
    end

    if #availableDirections == 0 then
        availableDirections = directions
    end

    local direction = availableDirections[
        math.random(1, #availableDirections)
    ]

    lastDirection = direction

    local position = targetRoot.Position
        + direction * ORBIT_DISTANCE

    myRoot.CFrame = CFrame.lookAt(position, targetRoot.Position)
end)

--// OBSERVAR JOGADORES
local function WatchPlayer(player)
    if player == LocalPlayer then return end

    player.CharacterAdded:Connect(function()
        if _G.__OrbitImpulsoRunToken ~= RunToken or destroyed then
            return
        end

        task.wait(0.1)

        if selectedTarget == player and not targetIsNPC then
            ClearTarget()
        end
    end)

    player.CharacterRemoving:Connect(function()
        if not destroyed and selectedTarget == player and not targetIsNPC then
            ClearTarget()
        end
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    WatchPlayer(player)
end

Players.PlayerAdded:Connect(function(player)
    WatchPlayer(player)
    task.wait(0.2)

    if not destroyed and not showingNPCs then
        UpdatePlayerList()
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if selectedTarget == player and not targetIsNPC then
        ClearTarget()
    end

    task.wait(0.1)

    if not destroyed and not showingNPCs then
        UpdatePlayerList()
    end
end)

--// RESPAWN
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)

    if destroyed then return end

    if orbiting then
